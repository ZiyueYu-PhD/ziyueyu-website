---
// 顶部导航条：左侧姓名字标，右侧导航 + 中英文切换 + CV 按钮。
// 改导航项 → 改 links 数组。href 以 "/#" 开头 = 首页锚点；其他 = 独立页面。
// en/zh 分别是英文、中文标签，两份都会渲染，靠 <html>.lang-zh 控制显示哪一份。
const links = [
  { en: "About", zh: "关于", href: "/#about" },
  { en: "Programs", zh: "研究与论文", href: "/#programs" },
  { en: "Resume", zh: "履历", href: "/#resume" },
  { en: "News", zh: "动态", href: "/news" },
  { en: "Videos", zh: "视频", href: "/videos" },
  { en: "Photos", zh: "相册", href: "/photos" },
  { en: "Contact", zh: "联系", href: "/#contact" },
  { en: "Guestbook", zh: "留言墙", href: "/#guestbook" },
];
---

<header class="nav-top">
  <div class="nav-inner">
    <a class="brand" href="/">Ziyue&nbsp;Yu</a>
    <button class="nav-burger" aria-label="Toggle menu">☰</button>
    <nav class="nav-links">
      {links.map((link) => (
        <a href={link.href}>
          <span data-lang="en">{link.en}</span><span data-lang="zh">{link.zh}</span>
        </a>
      ))}
      <button class="lang-toggle" type="button" aria-label="切换到中文">中文</button>
      <a class="btn-cv" href="/files/Ziyue_Yu_CV.pdf" download>CV ↓</a>
    </nav>
  </div>
</header>

<script>
  // 移动端菜单开合；点导航链接后自动收起（切换按钮不算链接，点它菜单不收起）
  const burger = document.querySelector(".nav-burger");
  burger?.addEventListener("click", () => document.body.classList.toggle("nav-open"));
  document.querySelectorAll(".nav-links a").forEach((a) =>
    a.addEventListener("click", () => document.body.classList.remove("nav-open"))
  );

  // 中英文切换：切换 <html>.lang-zh，记住选择，并广播 langchange 事件（首屏打字机会监听）
  const langBtn = document.querySelector<HTMLButtonElement>(".lang-toggle");
  const root = document.documentElement;

  function syncLangButton() {
    const zh = root.classList.contains("lang-zh");
    if (langBtn) {
      langBtn.textContent = zh ? "EN" : "中文";
      langBtn.setAttribute("aria-label", zh ? "Switch to English" : "切换到中文");
    }
    root.lang = zh ? "zh" : "en";
  }

  syncLangButton();

  langBtn?.addEventListener("click", () => {
    const zh = root.classList.toggle("lang-zh");
    try {
      localStorage.setItem("lang", zh ? "zh" : "en");
    } catch (e) {}
    syncLangButton();
    document.dispatchEvent(new CustomEvent("langchange", { detail: zh ? "zh" : "en" }));
  });
</script>
