<script>
  // 首屏打字机效果：想改轮播词条，改这两个数组即可（分中英文）
  const WORDS = {
    en: ["Ph.D. Candidate", "Fluid Mechanics Researcher", "Photographer"],
    zh: ["博士研究生", "流体力学研究者", "摄影爱好者"],
  };
  const el = document.getElementById("typed");

  function currentWords() {
    return document.documentElement.classList.contains("lang-zh") ? WORDS.zh : WORDS.en;
  }

  let words = currentWords();
  let wordIdx = 0;
  let charIdx = 0;
  let deleting = false;

  // 切换语言时：立即换成对应语言的词条，从头开始打字
  document.addEventListener("langchange", () => {
    words = currentWords();
    wordIdx = 0;
    charIdx = 0;
    deleting = false;
    if (el) el.textContent = "";
  });

  function tick() {
    if (!el) return;
    const word = words[wordIdx % words.length];
    charIdx += deleting ? -1 : 1;
    el.textContent = word.slice(0, charIdx);

    let delay = deleting ? 45 : 95;
    if (!deleting && charIdx === word.length) {
      delay = 1800; // 打完停一会儿
      deleting = true;
    } else if (deleting && charIdx === 0) {
      deleting = false;
      wordIdx = (wordIdx + 1) % words.length;
      delay = 350;
    }
    setTimeout(tick, delay);
  }

  tick();
</script>
