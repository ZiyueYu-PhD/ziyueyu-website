    <div class="hero-bg-inner">
      <p class="eyebrow light">Pittsburgh, PA · University of Pittsburgh</p>
      <h1>Ziyue Yu</h1>
      <p class="typed-line">
        <span id="typed"></span><span class="typed-cursor">|</span>
      </p>
      <p class="hero-advisor">
        Advised by
        <a href="https://www.leifang.org/team" target="_blank" rel="noopener noreferrer">Prof. Lei Fang</a>,
        studying turbulence where inertia almost vanishes.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/files/Ziyue_Yu_CV.pdf" download>Download CV</a>
        <a class="btn btn-ghost-light" href="/#programs">View Programs</a>
        <a class="btn btn-ghost-light" href="/photos">View Photos</a>
