            <h3><span data-lang="en">Teaching</span><span data-lang="zh">教学</span></h3>
            <div class="resume-item">
              <h4><span data-lang="en">Teaching Assistant, University of Pittsburgh</span><span data-lang="zh">助教，匹兹堡大学</span></h4>
              <span class="when">2024 – 2025</span>
              <p data-lang="en">CEE 1402 Fluid Mechanics · CEE 1610 Engineering and Sustainable Development</p>
              <p data-lang="zh">CEE 1402 流体力学 · CEE 1610 工程与可持续发展</p>
            </div>
          </div>

          <div class="resume-block block-awards">
            <h3><span data-lang="en">Selected Awards</span><span data-lang="zh">主要荣誉</span></h3>
            <div class="resume-item">
              <h4><span data-lang="en">Teaching Assistant of the Year</span><span data-lang="zh">年度最佳助教</span></h4>
              <span class="when">2025</span>
