  description="Ziyue Yu — Ph.D. candidate in Civil and Environmental Engineering at the University of Pittsburgh. Research on low-Reynolds-number turbulence, Lagrangian coherent structures, and active matter. Photographer."
>
  <!-- ============ 首屏：满屏大背景照 + 叠加文字 ============ -->
  <section id="home" class="hero-bg">
    <div class="hero-bg-inner hero-grid">
      <div class="hero-main">
        <p class="eyebrow light">
          <span data-lang="en">Pittsburgh, PA · University of Pittsburgh</span><span data-lang="zh">美国匹兹堡 · 匹兹堡大学</span>
        </p>
        <h1>Ziyue Yu</h1>
        <p class="typed-line">
          <span id="typed"></span><span class="typed-cursor">|</span>
        </p>
